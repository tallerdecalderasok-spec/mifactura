# Copiá este archivo como .env.local y reemplazá los valores antes de ejecutar.
# La aplicación rechaza los valores REPLACE_ME.
# Copiá la URI de conexión PostgreSQL desde Connect en el Dashboard de Supabase.
# Elegí la conexión según el runtime/hosting; codificá caracteres reservados de la contraseña.
DATABASE_URL=postgresql://postgres:REPLACE_ME@db.PROJECT_REF.supabase.co:5432/postgres
DATABASE_SSL=require

# Credenciales diferentes para el handshake y la firma del webhook.
WA_VERIFY_TOKEN=REPLACE_ME
WA_APP_SECRET=REPLACE_ME

# No se necesitan para recibir webhooks y no se usan hasta implementar envíos.
WA_PHONE_ID=REPLACE_ME
WA_TOKEN=REPLACE_ME
WA_GRAPH_VERSION=REPLACE_ME

APP_BASE_URL=http://localhost:3000
